# MongoDB Configuration (optional - will use in-memory storage if not provided)
MONGO_URL=mongodb://localhost:27017
DB_NAME=roastmyidea

# Base URL for your deployment
NEXT_PUBLIC_BASE_URL=https://your-app.netlify.app

# CORS Configuration
CORS_ORIGINS=*

# Google Gemini API Key (required)
GOOGLE_GEMINI_API_KEY=your_api_key_here

# Gemini Model (use gemini-2.0-flash-exp or gemini-1.5-pro)
GEMINI_MODEL=gemini-2.0-flash-exp
